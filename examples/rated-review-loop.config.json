{
  "$schema": "./node_modules/rated-review-loop/config.schema.json",
  "guidelines": [
    "AGENTS.md",
    {
      "path": "docs/architecture/dependencies.md",
      "when": "an import crosses a feature boundary"
    }
  ],
  "checks": [
    "pnpm typecheck",
    "pnpm lint"
  ],
  "include": [
    "src/**/*.{ts,tsx}",
    "scripts/**/*.{js,mjs,ts}"
  ],
  "reviewer": {
    "mode": "session"
  },
  "language": "en"
}
